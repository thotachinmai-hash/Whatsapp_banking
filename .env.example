# Sarvam API key — https://api.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_STT=saaras:v3
SARVAM_TTS=bulbul:v3
SARVAM_VISION=sarvam-105b

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=postgresql://banking_user:banking_pass@localhost:5432/banking_db

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Business Cloud API
ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_webhook_verify_token_here

# Security — webhook authentication
WEBHOOK_SECRET=your_random_webhook_secret_here

# LLM fallback intent classification — catches colloquial/fragmented
# phrasing the fast keyword rules miss (e.g. "money money how much").
# Only fires when the rules find nothing, so it doesn't slow down
# clearly-matched requests.
LLM_FALLBACK_ENABLED=true
