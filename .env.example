# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_QWEN_MODEL=qwen/qwen3.6-27B

# Database
DATABASE_URL=postgresql://banking_user:banking_pass@localhost:5432/banking_db

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Business Cloud API
ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_webhook_verify_token_here

# Security — webhook authentication
WEBHOOK_SECRET=your_random_webhook_secret_here
GEMINI_API_KEY=yourcode
