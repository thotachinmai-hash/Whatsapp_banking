# ── Sarvam AI — https://api.sarvam.ai ────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT=saaras:v3
SARVAM_TTS=bulbul:v3
# Optional: pin a specific chat model instead of the defaults below.
# SARVAM_MODEL_FAST=sarvam-105b-conversations       # used for nearly every LLM call
# SARVAM_MODEL_REASONING=sarvam-105b                # reserved for deeper reasoning, rarely needed
# Cheque/KYC/document image extraction uses Sarvam's Document Intelligence
# API and takes no model override — there is no SARVAM_VISION setting.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://whatsapp_banking_database_user:t4ISE4cq4WX3gqH3slRArxcUiwaAWls9@dpg-dad658f10e5c73dgheo0-a.oregon-postgres.render.com/whatsapp_banking_database
# Connection pool size (optional — defaults to 1/10 if unset). Raise
# DB_POOL_MAX if Postgres is on a plan with a higher connection limit
# and you're seeing pool exhaustion under load.
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── WhatsApp Business Cloud API ──────────────────────────────────────────
ACCESS_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_webhook_verify_token_here
# Graph API version (optional — defaults to v25.0 if unset).
# GRAPH_API_VERSION=v25.0

# ── Security ──────────────────────────────────────────────────────────────
# Verifies the X-Hub-Signature-256 header on incoming webhook POSTs,
# confirming a request genuinely came from Meta and wasn't forged by a
# third party who found the URL. Required in production.
APP_SECRET=your_random_webhook_secret_here

# ── Feature flags ─────────────────────────────────────────────────────────
# Enables an LLM-assisted fallback for flexible yes/no & menu-choice
# matching (app/workflows/nlu.py) — used only when the rule-based matching
# doesn't recognize a reply. All other intent understanding (greeting,
# workflow start/switch/continue/correct/cancel, side questions,
# out-of-scope) is handled unconditionally by the LLM router
# (app/conversation/intent/llm_routing.py) and is not gated by this flag.
LLM_FALLBACK_ENABLED=true
